# Firebase Admin SDK : JSON sérialisé du compte de service
FIREBASE_SERVICE_ACCOUNT={"type":"service_account"}

# CinetPay
CINETPAY_API_KEY=your_api_key
CINETPAY_SITE_ID=your_site_id
CINETPAY_SECRET=your_secret
CINETPAY_API_URL=https://api.cinetpay.com/v1

# URL publique de ce serveur, utilisée pour le webhook et le retour de paiement
BASE_URL=https://your-payment-server.vercel.app

# Proxy Anthropic optionnel
ANTHROPIC_API_KEY=your_anthropic_api_key
