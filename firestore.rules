rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Fonctions d'aide ---
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSubscriberOfEmail(emailId) {
      // Vérifie si l'utilisateur courant a un abonnement actif pour cet email
      return exists(/databases/$(database)/documents/subscribers/$(request.auth.uid + '_' + emailId)) &&
             get(/databases/$(database)/documents/subscribers/$(request.auth.uid + '_' + emailId)).data.statut == 'actif';
      // Alternativement, on peut faire une requête sur la collection subscribers avec userId et emailId, mais une règle ne permet pas de requêter. Il faut structurer les IDs de documents comme "userId_emailId" pour un accès direct.
      // On supposera que les documents subscribers ont pour ID `${userId}_${emailId}`.
    }

    // --- Collection admins ---
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isAdmin(); // Seul un admin peut modifier les admins
    }

    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Collection services ---
    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // --- Collection emails (comptes partagés) ---
    match /emails/{emailId} {
      allow read: if isAdmin() || isSubscriberOfEmail(emailId);
      allow write: if isAdmin();
      // L'écriture (création/modification) des emails est réservée aux admins.
    }

    // --- Collection subscribers ---
    match /subscribers/{subId} {
      // Interdire la création directe par le client (uniquement via serveur Admin SDK)
      allow create: if false;
      // Lecture : l'admin peut tout voir, l'utilisateur ne voit que ses propres abonnements
      allow read: if isAdmin() || request.auth.uid == resource.data.userId;
      // Mise à jour : seul l'admin peut modifier le statut, la date de fin, etc.
      allow update: if isAdmin();
      // Suppression : admin seulement
      allow delete: if isAdmin();
    }

    // --- Collection notifications ---
    match /notifications/{notifId} {
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == resource.data.userId);
      allow write: if isAdmin() || request.auth.uid == resource.data.userId; // un client peut créer ses propres notifs (ou via serveur)
    }

    // --- Collection transactions ---
    match /transactions/{txId} {
      allow read: if isAdmin() || request.auth.uid == resource.data.userId;
      allow write: if isAdmin(); // seule l'admin ou le serveur (avec Admin SDK) crée les transactions
    }

    // --- Collection history ---
    match /history/{historyId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Collection journal ---
    match /journal/{journalId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
